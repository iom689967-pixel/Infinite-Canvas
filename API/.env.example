# Copy this file to API/.env and fill only the providers you use.
# Never commit API/.env or paste live credentials into this example.

# Provider endpoints and credentials
COMFLY_BASE_URL=https://api.example.invalid/v1
COMFLY_API_KEY=
MODELSCOPE_API_KEY=
RUNNINGHUB_API_KEY=
RUNNINGHUB_WALLET_API_KEY=
KIE_API_KEY=
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=

# Custom provider keys use API_PROVIDER_<PROVIDER_ID>_KEY.
API_PROVIDER_EXAMPLE_KEY=

# Optional model lists
IMAGE_MODELS=
CHAT_MODELS=
VIDEO_MODELS=
MODELSCOPE_CHAT_MODELS=

# Optional local/public endpoints
COMFYUI_INSTANCES=127.0.0.1:8188
PUBLIC_BASE_URL=
PUBLIC_MEDIA_BASE_URL=
PUBLIC_MEDIA_TOKEN=
