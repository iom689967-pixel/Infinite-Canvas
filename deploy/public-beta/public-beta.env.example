PUBLIC_BETA_ROOT=/opt/mio-canvas/public-beta
PUBLIC_BETA_INSTANCES_ROOT=/opt/mio-canvas/instances
PUBLIC_BETA_BACKUP_ROOT=/opt/mio-canvas/backups
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=38000
PUBLIC_BETA_ORIGIN=https://mio-canvas.eu.cc
PUBLIC_BETA_TRUSTED_PROXIES=127.0.0.1
PUBLIC_BETA_REGISTRATION_MODE=closed
PUBLIC_BETA_INVITE_CODE_HASH=
MAX_PUBLIC_USERS=20
INSTANCE_PORT_START=32000
INSTANCE_PORT_END=32999
INSTANCE_STORAGE_QUOTA=5368709120
MAX_UPLOAD_BYTES=52428800
MAX_CONCURRENT_GENERATIONS=2
MAX_RUNNING_INSTANCES=4
MIN_FREE_DISK_BYTES=10737418240
PUBLIC_BETA_BACKUP_RETENTION=7
PUBLIC_BETA_SUPERVISOR_SOCKET=/run/mio-canvas/supervisor.sock
# 0 preserves the previous no-idle-sleep policy. Set only by the operator.
PUBLIC_BETA_IDLE_SECONDS=0
# Configure a mail backend before opening email registration. Legacy login still works if disabled.
# Keep credentials only in the private server env; never commit populated values.
MIO_MAIL_MODE=disabled
# Recommended for Resend: mode=resend and the following sender. Key stays private.
MIO_MAIL_FROM=
MIO_RESEND_API_KEY=
# Optional exact sending domain; defaults to PUBLIC_BETA_ORIGIN hostname.
MIO_MAIL_SENDING_DOMAIN=
# SMTP-only settings are ignored in resend mode. MIO_SMTP_FROM remains a legacy alias.
MIO_SMTP_HOST=
MIO_SMTP_PORT=587
MIO_SMTP_USERNAME=
MIO_SMTP_PASSWORD=
MIO_SMTP_FROM=
MIO_SMTP_TLS=starttls
MIO_SMTP_TIMEOUT_SECONDS=10
MAX_PENDING_REGISTRATIONS=100
MIO_EMAIL_VERIFICATION_TTL_SECONDS=3600
MIO_PENDING_TTL_SECONDS=86400
# New registrations use six-digit codes; old link TTL remains migration-only.
MIO_EMAIL_CODE_TTL_SECONDS=600
MIO_EMAIL_CODE_MAX_ATTEMPTS=5
MIO_EMAIL_CODE_RESEND_SECONDS=60
MIO_EMAIL_CODE_HOURLY_LIMIT=5
MIO_EMAIL_CODE_IP_HOURLY_LIMIT=20
MIO_EMAIL_RESEND_COOLDOWN_SECONDS=60
MIO_EMAIL_RESEND_LIMIT=3
